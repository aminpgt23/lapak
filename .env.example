# Salin file ini ke .env lalu isi. Untuk Vercel: tambahkan variabel
# berikut di Dashboard Vercel → Project → Settings → Environment Variables.

# Database Configuration (Aiven Cloud MySQL)
DB_HOST=itjobs-mukhammadsyafiqulamin-69d7.h.aivencloud.com
DB_PORT=23587
DB_NAME=lapak_db
DB_USER=avnadmin
DB_PASSWORD=YOUR_DB_PASSWORD
DB_SSL=true

# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Configuration
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
JWT_EXPIRES_IN=7d

# Email Configuration (untuk verifikasi, opsional di Vercel)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@lapak.app

# App Configuration
APP_URL=https://lapak-tau.vercel.app
FRONTEND_URL=https://lapak-tau.vercel.app

# Supabase Storage (untuk upload gambar)
# Buat bucket public "lapak" di dashboard Supabase, lalu isi:
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_BUCKET=lapak
